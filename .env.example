# Supabase Configuration (Client-side)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Groq API Configuration (Server-side ONLY -- never expose this to the client)
# Multiple keys can be provided separated by commas for automatic round-robin rotation & failover
GROQ_API_KEY=gsk_key1,gsk_key2
GROQ_MODEL=qwen/qwen3.8-27b

# Organizer Password -- protects the Topic Management page
VITE_ORGANIZER_PASSWORD=your-secret-password-here

# Server Port
PORT=3001
