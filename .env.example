# Supabase Configuration (Client-side)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Gemini API Configuration (Server-side ONLY -- never expose this to the client)
# Multiple keys can be provided separated by commas for automatic round-robin rotation & failover
GEMINI_API_KEY=key1,key2
GEMINI_MODEL=gemini-3.5-flash-lite

# Organizer Password -- protects the Topic Management page
# ⚠️ SECURITY NOTE: The VITE_ prefix means this value is embedded in the
# client-side JS bundle and visible in browser DevTools. This is a deliberate
# trade-off for a live event tool. For production SaaS, move admin auth to
# Supabase Auth with role-based access and remove the VITE_ prefix.
VITE_ORGANIZER_PASSWORD=your-secret-password-here

# Server Port
PORT=3001
